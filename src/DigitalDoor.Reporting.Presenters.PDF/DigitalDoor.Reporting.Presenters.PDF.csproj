<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>Sergi Ortiz Gomez, Daniel Rosas Mialma</Authors>
		<Company>DIGITAL DOOR Pty Ltd</Company>
		<Description>Generate PDF reports from code using clean architecture and SkiaSharp. Can be used in backend API, in Blazor Server, Blazor Web Assembly, MVC and any .NET Core application, on Windows, Linux (Docker) and macOS.</Description>
		<Copyright>DIGITAL DOOR Pty Ltd 2022</Copyright>
		<PackageProjectUrl>https://digitaldoor.com.au/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>reporting; pdf; skiasharp; blazor; blazor webaassembly; blazor server; MVC; webapi</PackageTags>
		<PackageReleaseNotes>
			2026-09-29: BREAKING VISUAL CHANGES. Replaced iText with SkiaSharp and license changed from AGPL-3.0 to MIT. Public API unchanged. Page size uses real ISO points (72 per inch). Page margins and paddings are applied and sections are stacked from the top of the page like the HTML view. Font size is in points like the HTML view. Text is wrapped and clipped inside the cell. Rotation is around the centre of the cell. SVG images are drawn as vectors. Fonts are embedded in the PDF with Unicode support and Liberation Sans is included as fallback font. Text decoration and page background are now rendered. Fixed CurrentPage and TotalPages in header, body and footer (NullReferenceException and wrong total). Fixed base64 images (InvalidCastException). Fixed infinite loop when the row is higher than the body. Fixed custom fonts with concurrent reports. Errors with fonts and images are not hidden anymore. Linux and Blazor WebAssembly native assets included.
			2025-12-16: Fixed N blank pages. Update dependencies.
			2025-12-15: Add support NET 10. Update dependencies.
			2025-10-22: Update dependencies.
			2025-09-13: Fixed index out of range if no header, body or footer columns. Update documentation.
			2025-09-10: Update dependencies.
			2025-06-01: Update dependencies.
			2024-11-02: Improved conver mm to px. Improved convert to RGB colour. Update Nuget.
			2024-10-10: Update nugets.
			2024-08-30: Update nugets.
			2024-06-07: Update Nuget.
			2024-05-12: Update Nuget.
			2024-05-12: Add missing dependency from itext7.bouncy-castle-adapter.
			2024-05-11: Splited from DigitalDoor Reporting to follow SPR and OCR to avoid unnecesary dependencies in the main project.
		</PackageReleaseNotes>
		<Version>1.18.0</Version>
		<RepositoryUrl>https://github.com/drualcman/DigitalDoor.Reporting.Presenters.PDF</RepositoryUrl>
		<Title>Generate pdf from code using clean architecture</Title>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>DRIcon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DigitalDoor.Reporting" Version="1.18.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.20" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="SkiaSharp" Version="4.153.0" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.0" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.0" />
		<PackageReference Include="Svg.Skia" Version="5.2.3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DigitalDoor.Reporting.Presenters.PDF.Tests" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Fonts\*.ttf" LogicalName="DigitalDoor.Reporting.Presenters.PDF.Fonts.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\DRIcon.png" Link="DRIcon.png">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="THIRD-PARTY-NOTICES.txt">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>
</Project>
